rules_version = '2';

// Cloud Firestore Security Rules for bombom-arcade (Database: bombom-db)
// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: leaderboards/{gameType}/scores/{userId}
// Allowed {gameType}: 'dodge' | 'stack' | 'merge'
// Document ID {userId}: Firebase Auth UID (Anonymous Auth) matching request.auth.uid
// Fields (all required, no extraneous fields permitted):
//   - nickname: string (required, length 2..10) - public player display name
//   - score: int (required, range 0..1000000) - player high score (monotonic non-decreasing on update)
//   - skinId: string (required, enum) - equipped mascot skin ID
//   - updatedAt: timestamp (required, must equal request.time / serverTimestamp()) - last score update time
//
// Collection: nicknameClaims/{claimKey}
// Document ID {claimKey}: SHA-256 hex digest (64 lowercase hex chars) of "bombom-claim-v1:" + normalized nickname
// Fields (all required, immutable after creation, no extraneous fields permitted):
//   - ownerUid: string (required, must equal request.auth.uid) - anonymous UID that first claimed the nickname
//   - updatedAt: timestamp (required, must equal request.time / serverTimestamp()) - claim creation time
//
// Collection: profiles/{profileKey}
// Document ID {profileKey}: SHA-256 hex digest (64 lowercase hex chars) of "bombom-profile-v1:" + normalized nickname + ":" + 4-digit PIN
// Fields (all required, no extraneous fields permitted):
//   - nickname: string (required, length 2..10) - player display name
//   - stars: int (required, range 0..1000000) - golden stars balance
//   - starFragments: int (required, range 0..9) - mini star fragments toward next golden star
//   - highScores: map (required, keys ['dodge', 'stack'] plus optional 'merge')
//       - dodge: int (required, range 0..1000000)
//       - stack: int (required, range 0..1000000)
//       - merge: int (optional, range 0..1000000)
//   - unlockedSkins: list (required, length 1..10, contains 'bombom', all elements valid skin IDs) - unlocked skin IDs
//   - equippedSkin: string (required, valid skin ID and present in unlockedSkins) - equipped mascot skin ID
//   - updatedAt: timestamp (required, must equal request.time / serverTimestamp()) - last backup sync time
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated (including Firebase Anonymous Auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if authenticated user owns the document by matching UID to document ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate required fields exist on the incoming document
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // Validate string type and inclusive character length bounds
    function validStringLength(value, minLen, maxLen) {
      return value is string &&
        value.size() >= minLen &&
        value.size() <= maxLen;
    }

    // Validate lowercase 64-character SHA-256 hex digest format for hashed document IDs
    function isValidSha256Hex(value) {
      return value is string && value.matches('^[0-9a-f]{64}$');
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Restrict leaderboard subcollections to supported arcade game modes
    function isValidGameType(gameType) {
      return gameType in ['dodge', 'stack', 'merge'];
    }

    // Restrict mascot skin IDs to known skins defined in src/games/skins.js
    function isValidSkinId(skinId) {
      return skinId is string &&
        skinId in [
          'bombom',
          'strawberry-slime',
          'rocket-cat',
          'ribbon-bunny',
          'rainbow-cloud',
          'gold-unicorn',
          'mint-dino',
          'honey-bear',
          'angel-puppy',
          'galaxy-fairy'
        ];
    }

    // Strict schema, type, range, and server-timestamp validation for leaderboard entries
    function isValidLeaderboardEntry(data) {
      let requiredFields = ['nickname', 'score', 'skinId', 'updatedAt'];
      return hasRequiredFields(data, requiredFields) &&
        hasOnlyAllowedFields(data, requiredFields) &&
        validStringLength(data.nickname, 2, 10) &&
        data.score is int &&
        data.score >= 0 &&
        data.score <= 1000000 &&
        isValidSkinId(data.skinId) &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    // Strict schema, ownership, and server-timestamp validation for nickname claim entries
    function isValidNicknameClaim(data) {
      let requiredFields = ['ownerUid', 'updatedAt'];
      return hasRequiredFields(data, requiredFields) &&
        hasOnlyAllowedFields(data, requiredFields) &&
        data.ownerUid is string &&
        isOwner(data.ownerUid) &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    // Validate nested highScores map keys and integer score bounds (backward-compatible with v1.1.0)
    function isValidHighScoresMap(highScores) {
      let requiredGames = ['dodge', 'stack'];
      let allowedGames = ['dodge', 'stack', 'merge'];
      return highScores is map &&
        highScores.keys().hasAll(requiredGames) &&
        highScores.keys().hasOnly(allowedGames) &&
        highScores.dodge is int &&
        highScores.dodge >= 0 &&
        highScores.dodge <= 1000000 &&
        highScores.stack is int &&
        highScores.stack >= 0 &&
        highScores.stack <= 1000000 &&
        (!('merge' in highScores) ||
          (highScores.merge is int &&
            highScores.merge >= 0 &&
            highScores.merge <= 1000000));
    }

    // Validate unlockedSkins list size, default 'bombom' presence, and allowed skin IDs
    function isValidUnlockedSkinsList(unlockedSkins) {
      let allowedSkins = [
        'bombom',
        'strawberry-slime',
        'rocket-cat',
        'ribbon-bunny',
        'rainbow-cloud',
        'gold-unicorn',
        'mint-dino',
        'honey-bear',
        'angel-puppy',
        'galaxy-fairy'
      ];
      return unlockedSkins is list &&
        unlockedSkins.size() >= 1 &&
        unlockedSkins.size() <= 10 &&
        'bombom' in unlockedSkins &&
        unlockedSkins.hasOnly(allowedSkins);
    }

    // Strict schema, type, range, skin consistency, and server-timestamp validation for cloud profile backups
    function isValidProfileBackup(data) {
      let requiredFields = [
        'nickname',
        'stars',
        'starFragments',
        'highScores',
        'unlockedSkins',
        'equippedSkin',
        'updatedAt'
      ];
      return hasRequiredFields(data, requiredFields) &&
        hasOnlyAllowedFields(data, requiredFields) &&
        validStringLength(data.nickname, 2, 10) &&
        data.stars is int &&
        data.stars >= 0 &&
        data.stars <= 1000000 &&
        data.starFragments is int &&
        data.starFragments >= 0 &&
        data.starFragments <= 9 &&
        isValidHighScoresMap(data.highScores) &&
        isValidUnlockedSkinsList(data.unlockedSkins) &&
        isValidSkinId(data.equippedSkin) &&
        data.equippedSkin in data.unlockedSkins &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Public Top 15 arcade leaderboards (non-sensitive nickname, score, skinId only)
    match /leaderboards/{gameType}/scores/{userId} {
      // Allow public get/list only for valid game modes
      allow get, list: if isValidGameType(gameType);

      // Allow authenticated owner to create their initial score entry
      allow create: if isOwner(userId) &&
        isValidGameType(gameType) &&
        isValidLeaderboardEntry(request.resource.data);

      // Allow authenticated owner to update profile fields or raise their high score (never downgrade)
      allow update: if isOwner(userId) &&
        isValidGameType(gameType) &&
        isValidLeaderboardEntry(request.resource.data) &&
        request.resource.data.score >= resource.data.score;

      // Deny deletes to prevent leaderboard tampering or accidental wipe
      allow delete: if false;
    }

    // Hashed nickname uniqueness claims (prevents duplicate nicknames without exposing plaintext list)
    match /nicknameClaims/{claimKey} {
      allow get: if isAuthenticated() && isValidSha256Hex(claimKey);
      allow list: if false;
      allow create: if isAuthenticated() &&
        isValidSha256Hex(claimKey) &&
        isValidNicknameClaim(request.resource.data);
      allow update, delete: if false;
    }

    // PIN-hashed cloud backup profiles (accessible only by exact knowledge of SHA-256 profileKey)
    match /profiles/{profileKey} {
      allow get: if isAuthenticated() && isValidSha256Hex(profileKey);
      allow list: if false;
      allow create, update: if isAuthenticated() &&
        isValidSha256Hex(profileKey) &&
        isValidProfileBackup(request.resource.data);
      allow delete: if false;
    }

    // Default deny catch-all for all other collections and subcollections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
